---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { organization } from "../../data/schema";

const RECAPTCHA_SITE_KEY = "6LcWsJAsAAAAAEDbhLEDGfbNHrCn_fQNSNXaOdDN";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    name: "Contact SentioLogic",
    url: "https://sentiologic.site/contact/",
    about: { "@id": organization["@id"] },
  },
];
---

<SiteLayout
  title="Contact SentioLogic — Start a conversation"
  description="Tell SentioLogic about your software project or request a Sentio POS demo. Send us a message and our team will get back to you."
  jsonLd={jsonLd}
>
  <script slot="head" is:inline src={`https://www.google.com/recaptcha/api.js?render=${RECAPTCHA_SITE_KEY}`} async defer></script>

  <section class="contact-page dark">
    <div class="wrap contact-page-inner">
      <div class="contact-copy">
        <div class="eyebrow">Let’s build what’s next</div>
        <h1>Your next chapter<br />starts with a <em>conversation.</em></h1>
        <p>A new product, a better workflow, or a platform ready to scale. Tell us where you want to go.</p>
        <ul class="contact-points">
          <li><span>01</span>Your goals and the people the software is for</li>
          <li><span>02</span>Where things stand today: systems, timelines, constraints</li>
          <li><span>03</span>For a Sentio POS demo: business type, outlets and service style</li>
        </ul>
        <p class="contact-aside">Exploring our restaurant product? <a href="/pos/">Discover Sentio POS ↗</a></p>
      </div>

      <div class="form-card">
        <form class="contact-form" action="https://formspree.io/f/xreaallb" method="post" novalidate>
          <!-- Formspree: custom email subject -->
          <input type="hidden" name="_subject" value="New Contact from SentioLogic Website" />
          <!-- Formspree: honeypot spam protection -->
          <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
          <div class="field">
            <label for="topic">Topic</label>
            <select id="topic" name="topic">
              <option value="Project enquiry">Project enquiry</option>
              <option value="Sentio POS demo">Sentio POS demo</option>
              <option value="General question">General question</option>
            </select>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="name">Full Name</label>
              <input type="text" id="name" name="name" placeholder="Jane Smith" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="email">Email Address</label>
              <input type="email" id="email" name="email" placeholder="jane@company.com" autocomplete="email" required />
            </div>
          </div>
          <div class="field">
            <label for="company">Company <span class="optional">(Optional)</span></label>
            <input type="text" id="company" name="company" placeholder="Acme Corp" autocomplete="organization" />
          </div>
          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="6" placeholder="Tell us about your project…" required></textarea>
          </div>
          <input type="hidden" name="g-recaptcha-response" id="recaptchaResponse" />
          <button type="submit" class="btn">Send Message <span aria-hidden="true">↗</span></button>
        </form>
      </div>
    </div>
  </section>
</SiteLayout>

<script src="../../scripts/form-handler.js"></script>
