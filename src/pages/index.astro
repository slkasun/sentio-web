---
import SiteLayout from "../layouts/SiteLayout.astro";
import { organization } from "../data/schema";

const services = [
  {
    title: "Web Application Development",
    detail:
      "Web applications designed around the people who use them. We bring together intuitive interfaces and scalable architecture to support your business as it grows.",
    tags: ["Customer platforms", "Business applications", "Scalable architecture"],
  },
  {
    title: "Mobile Application Development",
    detail:
      "Native and cross-platform mobile experiences for customers and teams, with a focus on usability, performance and the practical demands of working on the move.",
  },
  {
    title: "Point-of-Sale Systems",
    detail:
      "Purpose-built POS systems for retail, hospitality and service businesses. Bring transactions and daily operations together in a workflow that makes sense for your team.",
  },
  {
    title: "Fintech Solutions",
    detail:
      "Financial technology platforms for payments, digital banking and transaction management, designed with security and relevant regulatory requirements in mind.",
  },
  {
    title: "Enterprise Software Platforms",
    detail:
      "Custom platforms for complex operations: ERP systems, internal tools, workflow automation and multi-tenant SaaS. Built to connect teams, information and processes.",
  },
];

const sectors = [
  ["Retail", "Connected commerce, inventory and customer experiences."],
  ["Banking & Finance", "Digital financial services and transaction platforms."],
  ["E-Commerce", "Storefronts, payments and fulfilment workflows."],
  ["Logistics", "Fleet management, route planning and tracking systems."],
  ["SMEs & Startups", "Focused digital solutions that make room for growth."],
];

const pad = (n: number) => String(n + 1).padStart(2, "0");

const jsonLd = [
  organization,
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://sentiologic.site/#website",
    name: "SentioLogic",
    url: "https://sentiologic.site/",
    publisher: { "@id": organization["@id"] },
  },
];
---

<SiteLayout
  title="SentioLogic — Software Engineering Company | Web, Mobile & POS"
  description="Software engineering for your next chapter. SentioLogic builds web, mobile, POS, fintech and enterprise platforms, and makes Sentio POS for restaurants."
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap hero-inner">
      <div>
        <div class="eyebrow">Your software engineering partner</div>
        <h1>Complex challenges.<br /><em>Clear solutions.</em></h1>
        <p class="intro">
          We design and build software that moves your business forward. Thoughtful architecture. Purposeful experiences.
          Built for what comes next.
        </p>
        <div class="actions">
          <a class="btn" href="/contact/">Start a Conversation <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="#services">Explore Our Services ↓</a>
        </div>
      </div>
      <div class="art" aria-hidden="true">
        <span class="cross">+</span>
        <img src="/assets/symbol.svg" alt="" width="340" height="340" fetchpriority="high" />
        <span class="art-label">CONNECTED THINKING / SENTIOLOGIC</span>
      </div>
    </div>
  </section>

  <div class="proof">
    <div class="wrap proof-inner">
      <div><strong>15+ years</strong><p>Collective industry experience</p></div>
      <div><strong class="small">From idea to delivery</strong><p>End-to-end software engineering</p></div>
      <div><strong class="small">Built around your business</strong><p>For enterprises and emerging businesses</p></div>
    </div>
  </div>

  <section class="section dark" id="product">
    <div class="wrap sector-layout">
      <div>
        <div class="eyebrow">Our product / Sentio POS</div>
        <h2>Built by us.<br />Made for your working day.</h2>
        <p>
          Our restaurant POS brings the terminal and Web Admin Portal together, from dine-in and takeaway orders to outlet
          setup and sales reporting.
        </p>
        <a class="btn light" href="/pos/">Explore Sentio POS <span aria-hidden="true">↗</span></a>
      </div>
      <a href="/pos/terminal/" aria-label="Explore Sentio POS Terminal">
        <img
          src="/assets/pos-billing.webp"
          alt="Sentio POS terminal with product categories and current order"
          width="1280"
          height="800"
          style="width:100%;height:auto;border-radius:8px"
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>
  </section>

  <section class="section wrap" id="services">
    <div class="section-head">
      <div>
        <div class="eyebrow">01 / What we build</div>
        <h2>The right software.<br />For your next chapter.</h2>
      </div>
      <p>
        From customer-facing applications to the platforms behind your operations, we turn business needs into reliable
        digital systems.
      </p>
    </div>
    {
      services.map((s, i) => (
        <details class="service" open={i === 0}>
          <summary>
            <span class="num">{pad(i)}</span>
            <h3>{s.title}</h3>
            <span class="plus" aria-hidden="true">+</span>
          </summary>
          <div class="detail">
            {s.detail}
            {s.tags && (
              <div class="tags">
                {s.tags.map((t) => (
                  <span>{t}</span>
                ))}
              </div>
            )}
          </div>
        </details>
      ))
    }
  </section>

  <section class="section dark" id="industries">
    <div class="wrap sector-layout">
      <div class="sector-copy">
        <div class="eyebrow">02 / Where we work</div>
        <h2>Different industries.<br />The same care<br />in every detail.</h2>
        <p>
          Good software starts with understanding the context. We bring engineering experience to the systems your business
          depends on.
        </p>
        <a class="text-link" href="/contact/">Tell Us About Your Business ↗</a>
      </div>
      <div class="sectors">
        {
          sectors.map(([name, text], i) => (
            <article>
              <span>{pad(i)}</span>
              <div>
                <h3>{name}</h3>
                <p>{text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section wrap" id="about">
    <div class="section-head">
      <div>
        <div class="eyebrow">03 / The people behind the thinking</div>
        <h2>Built on trust.<br />Driven by good engineering.</h2>
      </div>
      <p>
        Founded by industry veterans with over 15 years of collective experience, SentioLogic brings a practical,
        collaborative approach to building software.
      </p>
    </div>
    <div class="principles">
      <article>
        <span class="num">01 / CLARITY</span>
        <h3>Understand before building.</h3>
        <p>Start with the business challenge and the people involved. Make the scope, tradeoffs and next steps understandable.</p>
      </article>
      <article>
        <span class="num">02 / CRAFT</span>
        <h3>Think beyond the launch.</h3>
        <p>Design systems with maintainability, performance and future growth in mind from the beginning.</p>
      </article>
      <article>
        <span class="num">03 / PARTNERSHIP</span>
        <h3>Build together.</h3>
        <p>Keep communication open and delivery iterative, with a shared view of what matters most.</p>
      </article>
    </div>
  </section>

  <section class="section approach" id="approach">
    <div class="wrap">
      <div class="eyebrow">04 / How we approach delivery</div>
      <h2>Clear thinking, at every stage.</h2>
      <div class="steps">
        <article><span>01 — DISCOVER</span><h3>Find the right problem.</h3><p>Understand your goals, users and operational context.</p></article>
        <article><span>02 — DESIGN</span><h3>Shape the solution.</h3><p>Connect user experience, architecture and a practical plan.</p></article>
        <article><span>03 — BUILD</span><h3>Make steady progress.</h3><p>Develop iteratively, test carefully and keep the work visible.</p></article>
        <article><span>04 — EVOLVE</span><h3>Plan for what’s next.</h3><p>Use feedback and business needs to guide the next iteration.</p></article>
      </div>
    </div>
  </section>

  <section class="contact dark" id="contact">
    <div class="wrap contact-inner">
      <div>
        <div class="eyebrow">Let’s build what’s next</div>
        <h2>Your next chapter<br />starts with a conversation.</h2>
      </div>
      <div>
        <p>A new product, a better workflow, or a platform ready to scale. Tell us where you want to go.</p>
        <a class="btn light" href="/contact/">Discuss Your Project <span aria-hidden="true">↗</span></a>
        <small>Opens our short enquiry form.</small>
      </div>
    </div>
  </section>
</SiteLayout>
