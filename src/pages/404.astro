---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Page not found | SentioLogic" description="The page you were looking for could not be found." noindex>
  <section class="wrap not-found">
    <div class="eyebrow">404 / Page not found</div>
    <h1>This page has moved on.</h1>
    <p>The link may be out of date, or the page may no longer exist. Try one of these instead.</p>
    <div class="actions">
      <a class="btn" href="/">SentioLogic Home <span aria-hidden="true">↗</span></a>
      <a class="text-link" href="/pos/">Explore Sentio POS</a>
    </div>
  </section>
</SiteLayout>
